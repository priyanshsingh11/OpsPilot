# Copy to .env and adjust. Backend reads the root .env; frontend reads frontend/.env.local.

# --- Backend ---
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Defaults to backend/opspilot.db when unset
# DATABASE_URL=sqlite:///./backend/opspilot.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (copy to frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Reserved for later phases ---
# OPENAI_API_KEY=

# --- Demo recruitment app (demo-app/, port 5001) ---
DEMO_APP_PORT=5001
# Arms one failing interview-creation attempt whenever demo data is (re)seeded.
SIMULATE_CALENDAR_FAILURE=false
# before_write: nothing saved | after_write: interview saved but error returned
CALENDAR_FAILURE_MODE=before_write
