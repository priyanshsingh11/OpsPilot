# Copy to .env (cp .env.example .env). The backend reads this file.
# The frontend reads frontend/.env.local instead (cp frontend/.env.example frontend/.env.local).
# No API keys or credentials are needed: OpsPilot does not call any external service.

# --- Backend API ---
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# SQLite file for runs, events and approvals. Defaults to backend/opspilot.db when unset.
# DATABASE_URL=sqlite:///./backend/opspilot.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Agent ---
# The synthetic recruitment app the agent operates (demo-app/app). Port 5050 because
# macOS AirPlay Receiver holds port 5000.
DEMO_APP_URL=http://127.0.0.1:5050
# false = open a visible Chromium window so you can watch the agent work (use this for the demo video).
AGENT_HEADLESS=true
# Attempts for a failing action (first try + retries), and the wait between them.
AGENT_MAX_ATTEMPTS=3
AGENT_RETRY_BACKOFF_SECONDS=1.0
# Pause after every logged step so a live run is easy to follow on screen.
AGENT_STEP_DELAY_SECONDS=0.3

# --- Demo app failure simulation (optional) ---
# The demo app does NOT read this file. Normally you arm failures from the dashboard's
# "Failure scenario" picker. To arm one at demo-app startup instead, set these in the shell:
#   DEMO_FAILING_ATTEMPTS=1 DEMO_FAILURE_MODE=after_write ../.venv/bin/uvicorn app.main:app --port 5050
