# Copy to .env and adjust. Backend reads the root .env; frontend reads frontend/.env.local.

# --- Backend ---
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Defaults to backend/opspilot.db when unset
# DATABASE_URL=sqlite:///./backend/opspilot.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (copy to frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Reserved for later phases ---
# OPENAI_API_KEY=

# --- Demo recruitment app (demo-app/app, port 5050; macOS AirPlay Receiver holds 5000) ---
# Arms N failing interview-creation attempts whenever demo data is (re)seeded.
DEMO_FAILING_ATTEMPTS=0
# before_write: nothing saved | after_write: interview saved but an error returned
DEMO_FAILURE_MODE=before_write

# --- Agent (Phase 5) ---
DEMO_APP_URL=http://127.0.0.1:5050
AGENT_HEADLESS=true
AGENT_MAX_ATTEMPTS=3
AGENT_RETRY_BACKOFF_SECONDS=1.0
AGENT_STEP_DELAY_SECONDS=0.3
