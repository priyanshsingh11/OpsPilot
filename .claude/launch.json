{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo-app",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd demo-app && ../.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 5050"],
      "port": 5050
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && ../.venv/bin/uvicorn app.main:app --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 3000
    }
  ]
}
